# HAOS fragment applied on top of the mainline rock5a-rk3588s_defconfig.
# Do not carry the ROCK 5B target options (TARGET_ROCK5B_RK3588, DEFAULT_DEVICE_TREE,
# OF_LIST, SPI flash offsets, PCI/NVMe): they would override the 5A target.

# optee support
CONFIG_OPTEE_LIB=y

# required for booting using a script
CONFIG_BOOTMETH_SCRIPT=y
# useful for debugging boot issues
CONFIG_CMD_BOOTDEV=y
CONFIG_CMD_BOOTMETH=y

#Needed for Uboot HAOS env
CONFIG_CMD_SAVEENV=y
#Kaslrseed support
CONFIG_CMD_KASLRSEED=y
CONFIG_DM_RNG=y
