From: HAOS rk3588 <noreply@localhost>
Subject: [PATCH] arm64: dts: rockchip: orangepi-5b: add AP6275P WiFi/BT, white USB 2.0 port

The AP6275P (BCM43752) WiFi sits on pcie2x1l2 with WL_REG_ON on GPIO0_PD0,
its Bluetooth on UART9 (shutdown GPIO3_PA6, wake GPIO0_PC6, host-wake
GPIO0_PC5), both clocked from the HYM8563 32 kHz output. Wiring taken from
the Orange Pi vendor and Armbian 5B device trees.

The white USB 2.0 Type-A port shares the USB-C controller; make it default
to host mode when nothing is attached to the USB-C port.

---
--- a/arch/arm64/boot/dts/rockchip/rk3588s-orangepi-5b.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-orangepi-5b.dts
@@ -17,3 +17,100 @@
 &sdhci {
 	status = "okay";
 };
+
+/*
+ * On-board AP6275P (BCM43752) WiFi on PCIe 2.0 x1 (pcie2x1l2) and its
+ * Bluetooth on UART9, wired as in the Orange Pi vendor and Armbian 5B trees.
+ */
+/ {
+	vcc3v3_pcie20: regulator-vcc3v3-pcie20 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc3v3_pcie20";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		startup-delay-us = <50000>;
+		vin-supply = <&vcc_3v3_s3>;
+	};
+};
+
+&gpio0 {
+	wifi-reg-on-h {
+		gpio-hog;
+		gpios = <RK_PD0 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "wifi-reg-on-h";
+	};
+};
+
+&pcie2x1l2 {
+	reset-gpios = <&gpio3 RK_PD1 GPIO_ACTIVE_HIGH>;
+	vpcie3v3-supply = <&vcc3v3_pcie20>;
+	status = "okay";
+
+	pcie@0,0 {
+		reg = <0x400000 0 0 0 0>;
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+		device_type = "pci";
+		bus-range = <0x40 0x4f>;
+
+		wifi: wifi@0,0 {
+			compatible = "pci14e4,449d";
+			reg = <0x410000 0 0 0 0>;
+			clocks = <&hym8563>;
+			clock-names = "lpo";
+		};
+	};
+};
+
+&pinctrl {
+	bluetooth {
+		bt_reset_pin: bt-reset-pin {
+			rockchip,pins = <3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		bt_wake_pin: bt-wake-pin {
+			rockchip,pins = <0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+
+		bt_wake_host_irq: bt-wake-host-irq {
+			rockchip,pins = <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_down>;
+		};
+	};
+};
+
+&uart9 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart9m2_xfer &uart9m2_ctsn &uart9m2_rtsn>;
+	uart-has-rtscts;
+	status = "okay";
+
+	bluetooth {
+		compatible = "brcm,bcm43438-bt";
+		clocks = <&hym8563>;
+		clock-names = "lpo";
+		interrupt-parent = <&gpio0>;
+		interrupts = <RK_PC5 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "host-wakeup";
+		device-wakeup-gpios = <&gpio0 RK_PC6 GPIO_ACTIVE_HIGH>;
+		shutdown-gpios = <&gpio3 RK_PA6 GPIO_ACTIVE_HIGH>;
+		max-speed = <1500000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&bt_wake_host_irq &bt_wake_pin &bt_reset_pin>;
+		vbat-supply = <&vcc_3v3_s3>;
+		vddio-supply = <&vcc_1v8_s3>;
+	};
+};
+
+/*
+ * The white USB 2.0 Type-A port is wired to the USB 2.0 lines of the
+ * USB-C controller (usb_host0_xhci), which the FUSB302 role switch leaves in
+ * device mode when nothing is attached to the USB-C port. Default to host
+ * instead so the Type-A port works; a USB-C host still gets device mode.
+ */
+&usb_host0_xhci {
+	role-switch-default-mode = "host";
+};
