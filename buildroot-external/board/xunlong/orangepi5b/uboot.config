# HAOS fragment on top of U-Boot orangepi-5-rk3588s_defconfig (TARGET_EVB_RK3588).
# The Orange Pi 5B is an Orange Pi 5 with eMMC (sdhci) and WiFi/BT instead of
# SPI NOR and the M.2 slot, so switch to the 5B device tree and enable sdhci.
# Shared options (SETEXPR, FILEENV, EFI_PARTITION, ...) come from bootloader/uboot.config.
CONFIG_DEFAULT_DEVICE_TREE="rockchip/rk3588s-orangepi-5b"
CONFIG_DEFAULT_FDT_FILE="rockchip/rk3588s-orangepi-5b.dtb"
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_SDMA=y
CONFIG_MMC_SDHCI_ROCKCHIP=y
# no SPI NOR populated on the 5B
# CONFIG_ROCKCHIP_SPI_IMAGE is not set

# optee support
CONFIG_OPTEE_LIB=y

# required for booting using a script
CONFIG_BOOTMETH_SCRIPT=y
# useful for debugging boot issues
CONFIG_CMD_BOOTDEV=y
CONFIG_CMD_BOOTMETH=y

# Needed for Uboot HAOS env
CONFIG_CMD_SAVEENV=y
# Kaslrseed support
CONFIG_CMD_KASLRSEED=y
CONFIG_DM_RNG=y
