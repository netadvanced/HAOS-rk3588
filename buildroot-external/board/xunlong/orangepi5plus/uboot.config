# HAOS fragment on top of U-Boot orangepi-5-plus-rk3588_defconfig (TARGET_EVB_RK3588),
# which already provides PCI, NVMe, RTL8169, DWC3/xHCI, SPI image and the debug UART.
# Shared options (SETEXPR, FILEENV, EFI_PARTITION, ...) come from bootloader/uboot.config.

# optee support
CONFIG_OPTEE_LIB=y

# required for booting using a script
CONFIG_BOOTMETH_SCRIPT=y
# useful for debugging boot issues
CONFIG_CMD_BOOTDEV=y
CONFIG_CMD_BOOTMETH=y

# Needed for Uboot HAOS env
CONFIG_CMD_SAVEENV=y
# Kaslrseed support
CONFIG_CMD_KASLRSEED=y
CONFIG_DM_RNG=y
