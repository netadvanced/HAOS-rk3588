config BR2_PACKAGE_ROCKCHIP_MPP_ARCH_SUPPORTS
	bool "rockchip-mpp"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_aarch64 || BR2_arm
	select BR2_PACKAGE_LIBDRM
	help
	  Rockchip Media Process Platform (MPP). Bibliothèque
	  d'encodage/décodage vidéo matériel pour SoC Rockchip.

	  https://github.com/rockchip-linux/mpp

comment "mpp needs a toolchain w/ threads"
	depends on !BR2_TOOLCHAIN_HAS_THREADS
